{
    "name": "moi/starter-php-poo",
    "description": "Squelette de projet PHP POO réutilisable - architecture Domain/Application/Infrastructure/Presentation",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "respect/validation": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    }
}
